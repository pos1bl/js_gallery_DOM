"use strict";
var bigImage = document.querySelector("#largeImg");
var galleryList = document.querySelector("#thumbs");
galleryList.addEventListener("click", function(e) {
    var link = event.target.closest(".list-item__link");
    if (!link) return;
    e.preventDefault();
    bigImage.src = link.href;
});

